#!/bin/sh
# Secret scan of every commit about to be pushed. Fails closed.
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-push: gitleaks is required (brew install gitleaks); refusing to push unscanned commits" >&2
  exit 1
fi
zero=0000000000000000000000000000000000000000
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue   # branch deletion
  if [ "$remote_sha" = "$zero" ]; then range="$local_sha --not --remotes"; else range="$remote_sha..$local_sha"; fi
  gitleaks git --no-banner --redact=100 --log-opts="$range" . || exit 1
done
exit 0
